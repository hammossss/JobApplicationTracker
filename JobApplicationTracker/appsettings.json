{
  "ConnectionStrings": {
    // Anslutningssträngen för SQLite-databasen
    "DefaultConnection": "Data Source=jobs.db"
  },
  "Logging": {
    // Loggnivåer för olika kategorier
    "LogLevel": {
      "Default": "Information", // Standardloggnivå
      "Microsoft.AspNetCore": "Warning", // Logga varningar från ASP.NET Core
      "Microsoft": "Warning" // Logga varningar från Microsoft
    }
  },
  "AllowedHosts": "*", // Tillåt alla värdar (används för CORS)
  "Swagger": {
    "Title": "JobTracker API", // API-titel som visas i Swagger UI
    "Version": "v1" // API-version
  }
}

